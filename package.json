{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.1.38",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:oxlint": "oxlint",
    "test": "turbo run test",
    "test:watch": "turbo run test --watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "minimatch": "^10.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "oxlint": "1.78.0",
    "prettier": "^3.6.2",
    "shadcn": "^4.11.0",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
