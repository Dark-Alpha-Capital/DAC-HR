{
  "name": "shadcn-ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "minimatch": "^10.1.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
