{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node.js / Bun",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true
  }
}


