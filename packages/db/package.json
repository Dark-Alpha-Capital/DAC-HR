{
  "name": "@workspace/db",
  "main": "./index.ts",
  "types": "./index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6"
  },
  "exports": {
    ".": "./index.ts",
    "./db": "./db.ts",
    "./queries": "./queries.ts",
    "./repositories/*": "./repositories/*.ts",
    "./schema": "./schema.ts",
    "./question-types": "./question-types.ts",
    "./enums": "./enums.ts",
    "./application-status": "./application-status.ts",
    "./sqlite-helpers": "./sqlite-helpers.ts",
    "./index": "./index.ts"
  },
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run migrate.ts",
    "db:migrate:remote": "bun run migrate.ts --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run seed.ts",
    "db:seed:remote": "bun run seed.ts --remote"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1"
  }
}
