{
  "name": "@workspace/db",
  "main": "./index.ts",
  "types": "./index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260616.1",
    "@types/bun": "^1.3.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./modules/*": "./src/modules/*.ts",
    "./testing": "./src/testing.ts",
    "./schema": "./src/schema.ts",
    "./question-types": "./src/question-types.ts",
    "./enums": "./src/enums.ts",
    "./application-status": "./src/application-status.ts",
    "./candidate-list-filters": "./src/candidate-list-filters.ts",
    "./document-list-filters": "./src/document-list-filters.ts",
    "./default-rounds": "./src/default-rounds.ts",
    "./kanban-cursor": "./src/kanban-cursor.ts",
    "./sqlite-helpers": "./src/sqlite-helpers.ts",
    "./round-progression": "./src/round-progression.ts",
    "./location": "./src/location.ts",
    "./index": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "check-types": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:local": "bun run scripts/migrate.ts",
    "db:migrate:remote": "bun run scripts/migrate.ts --remote",
    "db:reset:local": "bun run scripts/reset-local-state.ts",
    "db:check": "bun run scripts/check-schema-sync.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed.ts",
    "db:seed:remote": "bun run scripts/seed.ts --remote",
    "db:seed-personality-round": "bun run scripts/seed-personality-round.ts",
    "db:seed-personality-round:remote": "bun run scripts/seed-personality-round.ts --remote",
    "db:seed-positions": "bun run scripts/seed-positions.ts",
    "db:seed-positions:remote": "bun run scripts/seed-positions.ts --remote",
    "db:reset-rounds": "bun run scripts/reset-position-rounds.ts",
    "db:reset-rounds:remote": "bun run scripts/reset-position-rounds.ts --remote",
    "db:finalize-interview-schema": "bun run scripts/finalize-interview-schema.ts",
    "db:finalize-interview-schema:remote": "bun run scripts/finalize-interview-schema.ts --remote"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "zod": "^4.1.12"
  }
}