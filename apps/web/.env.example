# Copy this file to apps/web/.env and fill in your values
# Never commit apps/web/.env to version control

# Database is Cloudflare D1 (binding DB in wrangler.jsonc — no DATABASE_URL needed)

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI
GEMINI_API_KEY=

# Nextcloud (document storage)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=

# Candidate Documents Search Store
CANDIDATE_DOCUMENTS_SEARCH_STORE_NAME=
