# Copy this file to apps/web/.env and fill in your values
# Never commit apps/web/.env to version control
#
# For local dev with the Cloudflare vite plugin, also copy the same secrets
# into apps/web/.dev.vars (Workers read .dev.vars, not .env).

# Database is Cloudflare D1 (binding DB in wrangler.jsonc — no DATABASE_URL needed)

# Better Auth
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI
GEMINI_API_KEY=

# Nextcloud (document storage)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=

# Candidate Documents Search Store
CANDIDATE_DOCUMENTS_SEARCH_STORE_NAME=

# Resend (email sending for interview links)
# Sign up at https://resend.com — free tier: 3,000 emails/month
# For production: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
