{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hr-automation-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "BETTER_AUTH_URL": "https://hr-automation-web.darkalpha.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-automation-db",
      "database_id": "d86703d9-2aa7-42b5-91a6-995fcf0afde0",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],

  "vectorize": [
  {
    "binding": "VECTORIZE",
    "index_name": "hr-documents-index"
  }
  ],


  "assets": {
    "directory": "./public"
  }
}
