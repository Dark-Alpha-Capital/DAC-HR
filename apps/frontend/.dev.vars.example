# Copy to apps/frontend/.dev.vars for local Wrangler dev (Workers runtime).
# Auth baseURL is derived per-request (localhost vs production) in auth-service.ts.
# wrangler.jsonc BETTER_AUTH_URL is the production fallback / email link origin.
# Override here only if you need a different fallback during local dev.

BETTER_AUTH_SECRET=your-secret-here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
RESEND_API_KEY=
PRISMIC_REPOSITORY_NAME=darkalpha
PRISMIC_TEAM_MEMBER_TYPE=teammember
PRISMIC_OPERATING_MEMBER_TYPE=operatingmember
# PRISMIC_ACCESS_TOKEN=
