# Copy this file to apps/frontend/.env and fill in your values
# Never commit apps/frontend/.env to version control
#
# For local dev with the Cloudflare vite plugin, also copy secrets into
# apps/frontend/.dev.vars (Workers read .dev.vars, not .env).
#
# Production secrets live in the Cloudflare dashboard (or `wrangler secret put`).
# wrangler.jsonc vars only holds non-secret config (e.g. BETTER_AUTH_URL).
# Never put API keys or passwords in wrangler.jsonc — deploy would overwrite dashboard secrets.
#
# Local dev uses remote D1/Vectorize bindings (see wrangler.jsonc remote: true).
# Run `bunx wrangler login` once so Vite can proxy to Cloudflare resources.

# Database is Cloudflare D1 (binding DB in wrangler.jsonc — no DATABASE_URL needed)
# Required for `bun run db:studio` (remote D1 via Drizzle HTTP driver)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override — defaults to hr-automation-db id from wrangler.jsonc
# CLOUDFLARE_D1_DATABASE_ID=d86703d9-2aa7-42b5-91a6-995fcf0afde0

# Better Auth — base URL is derived per-request in auth.ts (localhost vs production).
# Only set BETTER_AUTH_URL if you need to override the dynamic config.
BETTER_AUTH_SECRET=your-secret-here
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
# Requires Meet + Calendar APIs enabled in GCP, and these scopes on the OAuth client:
#   meetings.space.readonly, calendar.readonly
# Users must re-consent (sign out / sign in with Google) after scope changes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — also copy into .dev.vars for local Workers dev (authoritative for Worker routes).
# Production: `cd apps/frontend && bunx wrangler secret put OPENAI_API_KEY`
# If deploy uses `--env production`, also run with `--env production`.
# Keep .env and .dev.vars OPENAI_API_KEY identical locally, then restart `bun run dev`.
# Debug: GET http://localhost:3000/api/debug/openai-ping (check keyLast4, keysMatch, clientSecrets.ok).
OPENAI_API_KEY=

# Nextcloud (document storage)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=

# Resend (transactional email — outbox + queue consumer)
# Production: `cd apps/frontend && bunx wrangler secret put RESEND_API_KEY`
RESEND_API_KEY=

# Prismic (headless CMS — Content API)
# Repository API name from Settings → API & Security (not the display name)
PRISMIC_REPOSITORY_NAME=darkalpha
# Custom type API IDs (match your Prismic models)
PRISMIC_TEAM_MEMBER_TYPE=teammember
PRISMIC_OPERATING_MEMBER_TYPE=operatingmember
# Only if Content API access is Private (Settings → API & Security)
# PRISMIC_ACCESS_TOKEN=
