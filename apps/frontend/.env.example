# Copy this file to apps/frontend/.env and fill in your values
# Never commit apps/frontend/.env to version control
#
# For local dev with the Cloudflare vite plugin, also copy secrets into
# apps/frontend/.dev.vars (Workers read .dev.vars, not .env).
#
# Production secrets live in the Cloudflare dashboard (or `wrangler secret put`).
# wrangler.jsonc vars only holds non-secret config (e.g. BETTER_AUTH_URL).
# Never put API keys or passwords in wrangler.jsonc — deploy would overwrite dashboard secrets.
#
# Local dev uses remote D1/Vectorize bindings (see wrangler.jsonc remote: true).
# Run `bunx wrangler login` once so Vite can proxy to Cloudflare resources.

# Database is Cloudflare D1 (binding DB in wrangler.jsonc — no DATABASE_URL needed)
# Required for `bun run db:studio` (remote D1 via Drizzle HTTP driver)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional override — defaults to hr-automation-db id from wrangler.jsonc
# CLOUDFLARE_D1_DATABASE_ID=d86703d9-2aa7-42b5-91a6-995fcf0afde0

# Better Auth — base URL is derived per-request in auth.ts (localhost vs production).
# Only set BETTER_AUTH_URL if you need to override the dynamic config.
BETTER_AUTH_SECRET=your-secret-here
# BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=

# Nextcloud (document storage)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
